# Produktions-Konfiguration für docker-compose.yml
#
# Kopieren nach .env.prod und ausfüllen. KEINE Defaults: fehlt eine Variable, startet
# der Stack nicht (Fail-Fast über ${VAR:?}).
#
#   cp .env.prod.example .env.prod
#   node infra/nginx/generate-nginx.mjs
#   docker compose --env-file .env.prod up -d

# --- Admin-Host (zentral, nur Management-Netz) ---
KC_ENV=prod
# Öffentlicher Host für Mandanten-Logins (Issuer, Redirects). Muss ein eigener Name sein,
# NICHT der Admin-Host. Zertifikat: infra/nginx/certs/<KC_PUBLIC_HOSTNAME>/ (Mandanten-Vhost).
KC_PUBLIC_HOSTNAME=kc.gateway-vw.de
# Admin-Host (nur Management-Netz). Zertifikat: infra/nginx/certs/<KC_ADMIN_HOSTNAME>/.
# Auflösung nur per hosts-Datei oder internem DNS auf die VPS-IP, wenn möglich.
KC_ADMIN_HOSTNAME=kc-admin.gateway-vw.de
# Einzige Adresse, die die Admin-Oberfläche erreichen darf (statisch, /32)
MGMT_CIDR=<ADMIN_IP>/32

# --- Bootstrap-Admin (nur beim Erststart wirksam) ---
# Benutzername ist kein Geheimnis. Das PASSWORT steht NICHT hier, sondern in ./secrets/admin_password
KC_ADMIN_USER=kc-admin

# --- Datenbank ---
# Das DB-Passwort steht NICHT hier, sondern in ./secrets/db_password
KC_DB_NAME=keycloak
KC_DB_USER=keycloak
# verify-full verlangt ein DB-Zertifikat mit SAN 'postgres' (infra/pg/certs/pg-ca.crt
# wird nach keycloak/certs/pg-ca.crt kopiert). Ohne CA: require oder prefer setzen.
KC_DB_SSLMODE=verify-full

# --- Cluster ---
KC_CLUSTER_NAME=kc-prod
# Netz der Keycloak-Knoten; muss zu KC_PROXY_TRUSTED_ADDRESSES passen.
KC_PROXY_TRUSTED_ADDRESSES=172.30.0.10/32

# Öffentlicher HTTPS-Port des Nginx-Proxys (rootless Docker: >= 1024)
KC_PUBLIC_PORT=8443
# Separater Admin-Listener. Zugriff erzwingt die Provider-Firewall (Quell-IP),
# nicht nginx — rootless Docker liefert für jeden Client 172.30.0.1.
# Muss mit 'listen' in infra/nginx/templates/admin.conf.template übereinstimmen.
KC_ADMIN_PORT=8444
# --- Client-Secrets (pro Mandant!) ---
# Im Tenant-Register (keycloak/tenants.json) kann je Mandant 'clientSecret' stehen.
# Der Fallback-Wert steht in ./secrets/admin_client_secret (nicht hier).

# --- Betrieb ---
SESSION_TTL_SECONDS=900
AUTH_TTL_SECONDS=600

# --- Identitätsnachweis-Anbieter ---

# --- Realm-Provisionierung ohne Passwort ---
# Der Setup-Client wird beim ersten Lauf mit dem Bootstrap-Admin angelegt (KC_ADMIN_USER/
# KC_ADMIN_PASS) und bekommt die Master-Rolle 'create-realm'. Danach läuft die Provisionierung
# ausschließlich über client_credentials — die Bootstrap-Zugangsdaten können entfallen.
KC_SETUP_CLIENT_ID=realm-setup
# Das Setup-Client-Secret steht in ./secrets/setup_client_secret (nicht hier).

# --- Secrets erzeugen (einmalig, auf dem Zielsystem) ---
#   ./scripts/create-secrets.sh
# Erzeugt ./secrets/{db_password,admin_password,setup_client_secret,admin_client_secret}
# mit Modus 0400 und Besitzer = Keycloak-UID. Werte werden nicht ausgegeben.

# --- Mock-Portal ---
# Aktiviert die Mock-Mandanten (stage='mock') aus keycloak/tenants.json: eigener
# Host + eigener Realm, damit Test-Accounts den echten Mandanten-Realm nicht
# verunreinigen. Aktiviert Compose-Profil 'mock', Realm-Provisionierung und
# nginx-vhost. IM PRODUKTIVBETRIEB NICHT SETZEN (Default: aus).
# KC_ENABLE_MOCK_TENANTS=1

# --- Registrierungs-Pfad ---
# 'impersonation' (Default): das Portal etabliert die Session für die Passkey-Registrierung
# über die Impersonation-API. 'aia' kommt ohne Impersonation aus, setzt aber eine bereits
# bestehende Keycloak-Session voraus (z. B. Identity-Brokering) — siehe offene Punkte.
PORTAL_REGISTRATION_MODE=impersonation


# --- Keycloak-Only-Stack ---
# Portal und IDV-Anbieter werden extern betrieben; hier werden nur Keycloak, Postgres und nginx deployed.
